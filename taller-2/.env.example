# Copia este archivo como .env y llena los valores reales.
# El archivo .env NO se sube a GitHub (esta en el .gitignore).

# --- Base de datos PostgreSQL (datos entregados por el docente) ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Broker MQTT ---
MQTT_BROKER=
MQTT_PORT=1883
MQTT_TOPIC=iot/sensors/GAS-006/data
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60

# true = la API arranca tambien el consumidor MQTT
# false = solo la API (sirve para hacer consultas sin guardar datos nuevos)
MQTT_ENABLED=true
